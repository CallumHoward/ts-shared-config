{
  "name": "@wcmj/config-tailwind",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumHoward/ts-shared-config.git",
    "directory": "packages/config-tailwind"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "default": "./dist/stylelint.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./fallow": "./fallow.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fallow.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wcmj/config-base": "workspace:*",
    "@tailwindcss/vite": "^4.3.1"
  },
  "peerDependencies": {
    "oxfmt": ">=0.58.0 <1.0.0",
    "stylelint": "^17.14.0",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxfmt": "^0.58.0",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  }
}
