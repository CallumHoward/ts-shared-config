{
  "name": "@wcmj/config-tanstack",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumHoward/ts-shared-config.git",
    "directory": "packages/config-tanstack"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "pnpm run lint:ts",
    "lint:ts": "oxlint --type-aware --report-unused-disable-directives-severity=error",
    "lint:ci": "oxlint --type-aware --report-unused-disable-directives-severity=error --format=github",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives-severity=error --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@wcmj/config-base": "workspace:*",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-start": "^1.168.56",
    "nitro": "3.0.260610-beta"
  },
  "devDependencies": {
    "@wcmj/config-utilities": "workspace:*",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "oxlint": "^1.79.0",
    "typescript": ">=6",
    "@tanstack/react-router": "^1.170.0",
    "oxfmt": ">=0.58.0 <1.0.0"
  }
}
