{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "@callumhoward/config-base — vanilla-TS base. Extend via \"extends\". The react add-on layers jsx + DOM lib + vite/client types.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
