    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "stylelint": "^17.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
