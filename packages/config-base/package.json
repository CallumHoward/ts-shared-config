{
  "name": "@wcmj/config-base",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumHoward/ts-shared-config.git",
    "directory": "packages/config-base"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "fallow.json",
    "lefthook.yml",
    "schema",
    "templates"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "default": "./dist/stylelint.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rules-from-config": {
      "types": "./dist/rules-from-config.d.ts",
      "default": "./dist/rules-from-config.js"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./fallow": "./fallow.json",
    "./package.json": "./package.json",
    "./lefthook.yml": "./lefthook.yml",
    "./schema/pnpm-workspace": "./schema/pnpm-workspace.json",
    "./schema/pnpm-workspace.json": "./schema/pnpm-workspace.json",
    "./schema/sill-policy": "./schema/sill-policy.jsonc"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "pnpm run lint:ts",
    "lint:ts": "oxlint --type-aware --report-unused-disable-directives-severity=error",
    "lint:ci": "oxlint --type-aware --report-unused-disable-directives-severity=error --format=github",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives-severity=error --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@csstools/stylelint-formatter-github": "^2.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@wcmj/sill": "0.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.79.0",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@wcmj/sill": "^0.1.0",
    "fallow": "^2.89.0 || ^3.0.0",
    "lefthook": "^2.1.9",
    "oxfmt": ">=0.58.0 <1.0.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2003",
    "stylelint": "^17.14.0",
    "typescript": ">=6 <6.1.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
