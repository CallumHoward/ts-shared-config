{
  "name": "ts-shared-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "check:packages": "pnpm -r --filter \"./packages/*\" run check",
    "lint:packages": "pnpm -r --filter \"./packages/*\" run lint",
    "test:packages": "pnpm -r --filter \"./packages/*\" run test",
    "check": "pnpm -r --filter \"./examples/*\" run check",
    "lint": "pnpm -r --filter \"./examples/*\" run lint",
    "lint:css": "pnpm -r --filter \"./examples/*\" run lint:css",
    "format:check": "pnpm -r --filter \"./examples/*\" run format:check",
    "fallow": "pnpm -r --filter \"./examples/*\" run fallow",
    "test": "pnpm -r --filter \"./examples/*\" run test",
    "validate": "pnpm check:schemas && pnpm build && pnpm check:packages && pnpm lint:packages && pnpm test:packages && pnpm check && pnpm lint && pnpm lint:css && pnpm format:check && pnpm fallow && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "check:schemas": "sill check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@wcmj/sill": "0.1.0"
  }
}
